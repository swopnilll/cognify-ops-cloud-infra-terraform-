# Copy to server/.env.prod (git-ignored) and fill in.
# scripts/deploy-api.sh adds SQS_QUEUE_URL and AWS_REGION from Terraform.

# Letters and digits only: this value goes into a connection URL.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Signs the login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Needed for embeddings and Intellecta. The API starts without a real key,
# but the AI features fail until one is set.
OPENAI_API_KEY=changeme
OPENAI_CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
