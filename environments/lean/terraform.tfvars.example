# Copy to terraform.tfvars (git-ignored) and fill in.

aws_account_id   = "123456789012"    # your NEW personal account, not a work one
aws_profile      = "cognify"         # created with: aws configure --profile cognify
ssh_public_key   = "ssh-ed25519 AAAA... you@laptop"
ssh_allowed_cidr = "203.0.113.7/32"  # your IP: curl -s https://checkip.amazonaws.com
budget_email     = "you@example.com"
